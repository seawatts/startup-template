{
  "dependencies": {
    "@seawatts/id": "workspace:*",
    "@seawatts/logger": "workspace:*",
    "@seawatts/zustand": "workspace:*",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "catalog:",
    "lodash-es": "4.17.23",
    "next": "catalog:",
    "postgres": "4.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.8.3",
    "@seawatts/tsconfig": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "@testing-library/jest-dom": "6.9.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.4.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "chokidar": "5.0.0",
    "drizzle-kit": "0.31.9",
    "supabase": "2.77.1",
    "typescript": "catalog:",
    "zx": "8.8.5"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./client": "./src/client.ts",
    "./schema/*": "./src/schema/*.ts",
    "./supabase/*": "./src/supabase/*.ts",
    "./supabase/cli": "./src/supabase/cli.ts",
    "./supabase/rcs": "./src/supabase/server.rcs.ts"
  },
  "license": "MIT",
  "name": "@seawatts/db",
  "private": true,
  "scripts": {
    "bootstrap": "bun scripts/bootstrap-roles.ts",
    "build.skip": "bun run gen-supabase-types",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "bun scripts/watch.ts",
    "enable-supabase-realtime": "bun scripts/enable-supabase-realtime.ts",
    "gen-migration": "drizzle-kit generate",
    "gen-supabase-types": "bun scripts/generate-supabase-types.ts",
    "local": "bun scripts/local-database.ts",
    "migrate": "drizzle-kit migrate && bun gen-supabase-types && bun enable-supabase-realtime",
    "push": "drizzle-kit push && bun gen-supabase-types && bun enable-supabase-realtime",
    "seed": "bun src/seed.ts",
    "start": "supabase start",
    "studio": "drizzle-kit studio",
    "test:integ": "bun test --test=integ",
    "test:unit": "bun test --test=unit",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "verify": "bun scripts/verify-isolation.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
