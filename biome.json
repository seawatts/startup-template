{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!dist",
      "!**/dist",
      "!node_modules",
      "!**/node_modules",
      "!**/.next",
      "!**/.react-email",
      "!**/baml_client",
      "!**/.turbo",
      "!**/*.min.*",
      "!bun.lock",
      "!**/.vscode-test",
      "!**/build",
      "!**/.git",
      "!**/coverage",
      "!**/.nyc_output",
      "!**/packages/ai",
      "!**/.grit",
      "!**/apps/chrome-extension/scripts/detect-obfuscation"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": ["React"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noStaticElementInteractions": "off"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "off",
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "fix": "none",
          "level": "warn"
        },
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useUniqueElementIds": "off"
      },
      "nursery": {
        "recommended": true
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "recommended": true,
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "error",
        "noNegationElse": "off",
        "noNestedTernary": "off",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedIf": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/chrome-extension/postcss.config.js",
        "apps/web-app/postcss.config.mjs"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/chrome-extension/src/utils/existing-inputs/application/tests/mock-data/index.ts",
        "apps/chrome-extension/src/utils/existing-inputs/readonly/tests/mock-data/index.ts",
        "apps/cli/src/components/form/index.ts",
        "apps/cli/src/guards/index.ts",
        "apps/expo/src/components/piano/index.ts",
        "apps/expo/src/utils/usb-midi-service.ts",
        "apps/web-app/src/app/(marketing)/_components/sections/pricing-section/index.ts",
        "packages/analytics/src/components/index.ts",
        "packages/analytics/src/index.ts",
        "packages/analytics/src/posthog/chrome-extension.tsx",
        "packages/api/src/index.ts",
        "packages/api/src/react/client-exports.ts",
        "packages/api/src/react/server-exports.ts",
        "packages/api/src/services/index.ts",
        "packages/auth/src/index.ts",
        "packages/email/src/templates/index.ts",
        "packages/logger/src/index.ts",
        "packages/stripe/src/guards/client.ts",
        "packages/stripe/src/guards/server.ts",
        "packages/ui/src/custom/index.ts",
        "packages/ui/src/custom/portal.tsx",
        "packages/ui/src/custom/theme.tsx",
        "packages/utils/src/index.ts",
        "packages/zustand/src/index.ts",
        "tooling/testing/src/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/styles/theme.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
