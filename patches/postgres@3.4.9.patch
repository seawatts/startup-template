diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170..b44e69e 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -78,6 +78,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       , lifeTimer = timer(end, options.max_lifetime)
       , connectTimer = timer(connectTimedOut, options.connect_timeout)
 
+  // Template patch: whether the server's last ReadyForQuery said this
+  // connection is inside a transaction block (status T).
+  let inTransaction = false
+
   let socket = null
     , cancelMessage
     , errorResponse = null
@@ -172,11 +176,28 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      // Template patch: a BEGIN reserves its connection whatever write()
+      // returns. Upstream only reserved it when the socket took the bytes
+      // without backpressure, so a BEGIN written to a busy link left the pool
+      // connection open inside a transaction nobody committed: the next
+      // queries and BEGINs on it joined that transaction (25001) and its
+      // locks held until a request timed out.
+      const pipelines = write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
+        // Template patch: pipeline only inside a transaction block. Supabase's
+        // transaction pooler (Supavisor) hands the server connection back
+        // after each query outside a transaction and drops the queries a
+        // client pipelined behind it, so their callers waited forever.
+        // Inside a transaction the server connection stays put, and queries
+        // issued together there still pipeline.
+        && inTransaction
+      if (q.options.onexecute) {
+        q.options.onexecute(connection)
+        return false
+      }
+      return pipelines
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
@@ -223,6 +244,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     ])
   }
 
+  function describeParameter(x) {
+    return x !== null && typeof x === 'object' && !(x instanceof Date) && !(x instanceof Uint8Array)
+  }
+
   function build(q) {
     const parameters = []
         , types = []
@@ -237,7 +262,13 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     q.onlyDescribe && (delete statements[q.signature])
     q.parameters = q.parameters || parameters
     q.prepared = q.prepare && q.signature in statements
-    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared)
+    // Template patch: an unprepared query whose parameters are all scalars
+    // (text, numbers, booleans, dates, bytes) needs no Describe round trip
+    // before Bind: the server infers each type and every scalar serializes to
+    // the same text either way. Arrays and objects still describe first, since
+    // their text form depends on the parameter's type. Skipping it halves the
+    // round trips of each query and lets queries on one connection pipeline.
+    q.describeFirst = q.onlyDescribe || (q.parameters.length && !q.prepared && (q.prepare || q.parameters.some(describeParameter)))
     q.statement = q.prepared
       ? statements[q.signature]
       : { string, types, name: q.prepare ? statementId + statementCount++ : '' }
@@ -535,6 +566,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function ReadyForQuery(x) {
+    inTransaction = x[5] === 84
     if (query) {
       if (errorResponse) {
         query.retried
@@ -563,7 +595,12 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
 
       if (needsTypes) {
         initial.reserve && (initial = null)
-        return fetchArrayTypes()
+        // Template patch: nothing awaits this type read, so when the pooler
+        // drops or refuses a new connection during it (a connect timeout,
+        // ECHECKOUTTIMEOUT) its rejection was unhandled. The same error has
+        // already failed the query that opened the connection, whose caller
+        // handles it, so this copy is dropped.
+        return fetchArrayTypes().catch(noop)
       }
 
       initial && !initial.reserve && execute(initial)
